# Database Connection
DATABASE_URL="mysql://user:password@localhost:3306/ecommerce_db"

# NextAuth Configuration
# Generate a new secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<generate-a-strong-secret>"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SSLCommerz Integration (sandbox by default; set IS_LIVE=true for production)
STORE_ID="<your-store-id>"
STORE_PASSWORD="<your-store-password>"
IS_LIVE="false"

# Admin bootstrap (used by: npm run promote-admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<strong-password-min-8-chars>"
ADMIN_NAME="Admin"

# Category tile image generation (used by: npm run tiles:generate)
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: text model for generated article prose (default: gemini-2.5-flash)
GEMINI_TEXT_MODEL="gemini-2.5-flash"
# Optional: folder with images generated by the Gemini/Antigravity IDE
# (used by: npm run tiles:sync)
GEMINI_BRAIN_DIR=""
