generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  image     String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  reviews   Review[]
  blogs     Blog[]
  comments  Comment[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String?
  icon      String?
  isFeatured Boolean   @default(false)
  products  Product[]
  parentId  String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  productCode     String?     @unique
  brand           String?
  description     String      @db.Text
  shortDescription String?    @db.Text
  specifications  String?     @db.Text
  price           Float
  discountedPrice Float?
  stock           Int         @default(0)
  isTrending      Boolean     @default(false)
  images          String      @db.Text
  attributes      Json?
  availabilityStatus String?  @default("IN_STOCK")
  isActive        Boolean     @default(true)
  sourceUrl       String?
  sourceStatus    String?
  lastSyncedAt    DateTime?
  discontinuedAt  DateTime?
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants        Variant[]
  orderItems      OrderItem[]
  reviews         Review[]
  priceHistory    PriceHistory[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
  @@index([sourceStatus])
  @@index([lastSyncedAt])
  @@index([isActive, availabilityStatus, createdAt])
  @@index([categoryId, isActive, availabilityStatus])
  @@index([isTrending, createdAt])
  @@index([brand])
  @@index([price])
}

model PriceHistory {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice            Float?
  newPrice            Float?
  oldDiscountedPrice  Float?
  newDiscountedPrice  Float?
  sourceStatus        String?
  createdAt           DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  size      String?
  capacity  String?
  stock     Int      @default(0)
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("COD")
  shippingAddress String      @db.Text
  transactionId   String?     @unique
  valId           String?
  paymentStatus   String      @default("PENDING")
  bankTranId      String?
  cardType        String?
  cardNo          String?
  cardIssuer      String?
  cardBrand       String?
  cardCategory    String?
  riskLevel       Int?
  riskTitle       String?

  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Float
}

model Banner {
  id        String   @id @default(cuid())
  image     String
  imageMobile String?
  title     String?
  buttonText String?
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Blog {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String     @db.Text
  excerpt     String?    @db.Text
  imageUrl    String?
  category    String?
  tags        Json?
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  generatedBy String?
  sourceData  Json?
  reviewedAt  DateTime?
  reviewedById String?
  viewCount   Int        @default(0)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([category, status])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
